# Copy to .env and replace the bootstrap password before first run.
SCHOOL_ADMIN_USERNAME=admin@church.local
SCHOOL_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
ASPNETCORE_ENVIRONMENT=Development
Database__Provider=Sqlite

