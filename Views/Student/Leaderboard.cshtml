@model List<MyMvcApp10.Models.ApplicationUser>
@{
    ViewData["Title"] = "أعلى 10 مخدومين";
}

<div class="card p-4">
    <h2>أعلى 10 مخدومين في الدرجات</h2>
    <form method="get" class="row g-2 align-items-end mt-2">
        <div class="col-md-5"><label class="form-label">بحث</label><input name="search" value="@ViewBag.Search" class="form-control" placeholder="اسم المخدوم أو الفصل" /></div>
        <div class="col-md-4"><label class="form-label">المرحلة</label><select name="schoolLevelId" class="form-select"><option value="">كل المراحل</option>@foreach (var level in ViewBag.Levels) { <option value="@level.Id" selected="@(ViewBag.SchoolLevelId == level.Id)">@level.Name</option> }</select></div>
        <div class="col-md-3 d-flex gap-2"><button type="submit" class="btn btn-primary flex-grow-1">تصفية</button><a asp-action="Leaderboard" class="btn btn-outline-secondary">مسح</a></div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive mt-3">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>الترتيب</th>
                        <th>الاسم</th>
                        <th>الفصل</th>
                        <th>المرحلة</th>
                        <th>الرصيد</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var student = Model[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@student.FullName</td>
                            <td>@student.ClassName</td>
                            <td>@student.Level</td>
                            <td><span class="badge-score @(student.GradingBalance >= 0 ? "positive" : "negative")">@student.GradingBalance</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-center text-muted mt-3">لا توجد بيانات كفاية لعرض اللوحة حاليًا.</p>
    }
</div>
