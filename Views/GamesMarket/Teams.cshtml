@{
    ViewData["Title"] = "لوحة الفرق والمنافسة";
    var teams = ViewBag.Teams as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h2 class="fw-bold mb-1">🏆 لوحة الفرق والمنافسة</h2>
        <p class="text-muted mb-0">لوحة الفرق العامة؛ رصيد كل فريق هو مجموع درجات ونقاط أعضائه من المخدومين.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-primary">
            🎮 تصفح سوق الألعاب
        </a>
        <a asp-action="MyTeam" class="btn btn-primary">
            👥 فريقنا
        </a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="ManageTeams" class="btn btn-dark">
                ⚙️ إدارة وتعيين الفرق
            </a>
        }
    </div>
</div>

@if (!teams.Any())
{
    <div class="card text-center p-5 shadow-sm">
        <div class="fs-1 mb-2">👥</div>
        <h4>لا توجد فرق مضافة حتى الآن</h4>
        <p class="text-muted">يقوم المشرفون بإضافة الفرق وتعيين المخدومين إليها للمنافسة في سوق الألعاب.</p>
        @if (User.IsInRole("Admin"))
        {
            <div class="mt-2">
                <a asp-action="CreateTeam" class="btn btn-primary">➕ إضافة فريق جديد</a>
            </div>
        }
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @{
            int rank = 1;
        }
        @foreach (var team in teams)
        {
            var rankBadgeClass = rank switch
            {
                1 => "bg-warning text-dark border border-warning",
                2 => "bg-secondary text-white",
                3 => "bg-danger text-white",
                _ => "bg-light text-muted border"
            };

            var rankEmoji = rank switch
            {
                1 => "🥇 المركز الأول",
                2 => "🥈 المركز الثاني",
                3 => "🥉 المركز الثالث",
                _ => $"المركز #{rank}"
            };

            <div class="col">
                <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                        <span class="badge @rankBadgeClass px-3 py-2 fw-bold fs-6 rounded-pill">
                            @rankEmoji
                        </span>
                        <div class="text-end">
                            <span class="text-muted small">رصيد الفريق الإجمالي</span>
                            <div class="fs-4 fw-bold text-success">@(((int)team.TotalBalance).ToString("N0")) <small class="fs-6">نقطة</small></div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div style="width: 54px; height: 54px; border-radius: 50%; background: linear-gradient(135deg, #132c4a, #d4a73a); color: white; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; overflow: hidden; flex-shrink: 0;">
                                @if (!string.IsNullOrWhiteSpace((string)team.LogoUrl))
                                {
                                    <img src="@team.LogoUrl" alt="@team.Name" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src=''; this.parentElement.innerHTML='🛡️';" />
                                }
                                else
                                {
                                    <span>🛡️</span>
                                }
                            </div>
                            <div>
                                <h4 class="fw-bold mb-0 text-dark">@team.Name</h4>
                                <div class="text-muted small">@(((int)team.MemberCount)) أعضاء مسجلين</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace((string)team.Description))
                        {
                            <p class="text-muted small mb-3">@team.Description</p>
                        }

                        <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded-3 mb-3 text-center">
                            <div>
                                <div class="small text-muted">الكروت المشتراة</div>
                                <div class="fw-bold fs-5 text-primary">@team.BoughtCardsCount</div>
                            </div>
                            <div class="border-start border-end px-3">
                                <div class="small text-muted">الكروت المتاحة للاستخدام</div>
                                <div class="fw-bold fs-5 text-warning">@team.ActiveCardsCount</div>
                            </div>
                            <div>
                                <div class="small text-muted">متوسط نقاط العضو</div>
                                <div class="fw-bold fs-5 text-dark">
                                    @(team.MemberCount > 0 ? ((int)(team.TotalBalance / team.MemberCount)).ToString() : "0")
                                </div>
                            </div>
                        </div>

                        <div>
                            <h6 class="fw-bold text-secondary mb-2 small">👥 أعضاء الفريق:</h6>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var memberName in (IEnumerable<string>)team.Members)
                                {
                                    <span class="badge bg-white text-dark border px-2 py-1">
                                        👤 @memberName
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            rank++;
        }
    </div>
}
