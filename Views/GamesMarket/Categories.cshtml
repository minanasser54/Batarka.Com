@model IEnumerable<MyMvcApp10.Models.MarketCategory>
@{
    ViewData["Title"] = "إدارة أقسام سوق الألعاب";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h2 class="fw-bold mb-1">🏷️ إدارة أقسام سوق الألعاب</h2>
        <p class="text-muted mb-0">أضف أو احذف أقسام الكروت السحرية (مثال: PS، تلي ماتش، كرة القدم، أنشطة).</p>
    </div>
    <a asp-action="ManageCards" class="btn btn-outline-primary">🃏 العودة لإدارة الكروت</a>
</div>

<div class="row g-4">
    <!-- Add Category Form -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="fw-bold mb-0 text-dark">➕ إضافة قسم جديد</h5>
            </div>
            <div class="card-body">
                <form asp-action="CreateCategory" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-bold">اسم القسم <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="مثال: PS، تلي ماتش، كرة القدم" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">وصف القسم (اختياري)</label>
                        <input type="text" name="description" class="form-control" placeholder="وصف مختصر للقسم" maxlength="500" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-bold">حفظ القسم الجديد</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Categories List -->
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="fw-bold mb-0 text-dark">قائمة الأقسام الموجودة (@Model.Count())</h5>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <div class="fs-1 mb-2">🏷️</div>
                        <p>لا توجد أقسام مضافة بعد. أضف قسم جديد من اليسار.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-end pe-4">#</th>
                                    <th>اسم القسم</th>
                                    <th>الوصف</th>
                                    <th class="text-center">عدد الكروت</th>
                                    <th class="text-center">حذف</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int index = 1;
                                }
                                @foreach (var cat in Model)
                                {
                                    <tr>
                                        <td class="text-end pe-4">@index</td>
                                        <td class="fw-bold text-dark">
                                            <span class="badge bg-secondary me-1">🏷️</span> @cat.Name
                                        </td>
                                        <td class="text-muted small">@(cat.Description ?? "-")</td>
                                        <td class="text-center">
                                            <span class="badge @(cat.Cards.Any() ? "bg-primary" : "bg-light text-muted border")">
                                                @cat.Cards.Count كارت
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if (!cat.Cards.Any())
                                            {
                                                <form asp-action="DeleteCategory" asp-route-id="@cat.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف قسم [@cat.Name]؟');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" disabled title="لا يمكن حذف قسم يحتوي على كروت">
                                                    محمي
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                    index++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
