@model MyMvcApp10.Models.TeamCreateEditViewModel
@{
    ViewData["Title"] = "إنشاء فريق جديد";
    var students = ViewBag.AvailableStudents as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h4 class="fw-bold mb-0 text-dark">👥 إنشاء فريق جديد</h4>
                <a asp-action="ManageTeams" class="btn btn-sm btn-outline-secondary">عودة للفرق</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateTeam" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control" placeholder="مثال: فريق النسور" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LogoUrl" class="form-label fw-bold"></label>
                            <input asp-for="LogoUrl" class="form-control" placeholder="https://example.com/logo.png (اختياري)" />
                            <span asp-validation-for="LogoUrl" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <input asp-for="Description" class="form-control" placeholder="وصف مختصر للفريق (اختياري)" />
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Members Selection -->
                    <div class="mb-4">
                        <label class="form-label fw-bold">👤 اختيار أعضاء الفريق من المخدومين</label>
                        <p class="text-muted small mb-3">
                            الطالب المعلّم بـ <span class="badge bg-warning text-dark">مُعيَّن</span> مسجل في فريق آخر ولا يمكن إضافته لهذا الفريق.
                        </p>

                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
                            @foreach (var student in students)
                            {
                                bool isAssigned = (bool)student.IsAssigned;
                                <div class="col">
                                    <div class="border rounded-2 p-2 d-flex align-items-center gap-2 @(isAssigned ? "bg-light opacity-75" : "bg-white")" style="@(isAssigned ? "cursor: not-allowed;" : "cursor: pointer;")">
                                        <input type="checkbox"
                                               name="SelectedStudentIds"
                                               value="@student.Id"
                                               class="form-check-input m-0"
                                               id="stu_@student.Id"
                                               @(isAssigned ? "disabled" : "")
                                               style="min-width: 18px; min-height: 18px;" />
                                        <label for="stu_@student.Id" class="d-flex flex-column flex-grow-1 @(isAssigned ? "" : "cursor-pointer")" style="cursor: @(isAssigned ? "not-allowed" : "pointer");">
                                            <span class="fw-bold small text-dark">@student.FullName</span>
                                            <span class="text-muted" style="font-size: 11px;">
                                                @student.UserName
                                                @if (!string.IsNullOrWhiteSpace((string?)student.ClassName))
                                                {
                                                    <span> | @student.ClassName</span>
                                                }
                                                @if (isAssigned)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1">مُعيَّن</span>
                                                }
                                            </span>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (!students.Any())
                        {
                            <div class="alert alert-info mt-2">لا يوجد مخدومون نشطون لإضافتهم.</div>
                        }
                    </div>

                    <div class="pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4 fw-bold">💾 إنشاء الفريق</button>
                        <a asp-action="ManageTeams" class="btn btn-outline-secondary">إلغاء</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
