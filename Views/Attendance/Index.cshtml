@model MyMvcApp10.Models.AttendancePageViewModel
@{
    ViewData["Title"] = "تسجيل الحضور";
}

<div class="card p-4 mb-4">
    <h2>تسجيل الحضور</h2>
    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-sm-5 col-md-3">
            <label class="form-label" for="attendanceDate">اليوم</label>
            <input id="attendanceDate" name="date" type="date" class="form-control" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" type="submit">عرض اليوم</button>
        </div>
        <div class="col-auto">
            <a class="btn btn-outline-success" asp-action="ExportCsv" asp-route-date="@Model.SelectedDate.ToString("yyyy-MM-dd")">تنزيل حضور المخدومين CSV</a>
        </div>
        <div class="col-auto">
            <a class="btn btn-outline-secondary" asp-action="ExportTeachersCsv" asp-route-date="@Model.SelectedDate.ToString("yyyy-MM-dd")">تنزيل حضور الخدام CSV</a>
        </div>
    </form>
    <div class="row g-3 mb-4">
        <div class="col-sm-4"><div class="border rounded p-3"><div class="text-muted">الحضور</div><strong>@Model.TodayAttendance.Count</strong></div></div>
        <div class="col-sm-4"><div class="border rounded p-3"><div class="text-muted">المخدومين النشطين</div><strong>@Model.ActiveStudentCount</strong></div></div>
        <div class="col-sm-4"><div class="border rounded p-3"><div class="text-muted">الغياب</div><strong>@Model.MissingPeople.Count</strong></div></div>
        <div class="col-sm-4"><div class="border rounded p-3"><div class="text-muted">حضور الخدام</div><strong>@Model.TeacherAttendance.Count / @Model.ActiveTeacherCount</strong></div></div>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <h5>مسح الـ QR</h5>
            <form id="qrRegistrationForm" asp-action="RegisterByQr" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="attendanceDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                <div class="input-group">
                    <input id="qrCode" name="qrCode" class="form-control" placeholder="امسح أو اكتب قيمة الـ QR" autocomplete="off" />
                    <button class="btn btn-success" type="submit">تسجيل حضور</button>
                </div>
            </form>
            <div class="d-flex gap-2 mt-2">
                <button id="startScanner" class="btn btn-outline-primary" type="button">فتح الكاميرا</button>
                <button id="stopScanner" class="btn btn-outline-secondary" type="button" hidden>إيقاف الكاميرا</button>
                <span id="scannerStatus" class="small align-self-center" role="status"></span>
            </div>
            <div id="qrReader" class="mt-2" hidden></div>
        </div>
        <div class="col-md-6">
            <h5>البحث بالاسم</h5>
            <input id="searchName" class="form-control" placeholder="دور على اسم المخدوم أو الخادم" />
            <div id="searchResults" class="mt-2"></div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card p-3 mb-4">
            <h4>حضور المخدومين بتاريخ @Model.SelectedDate.ToString("dd/MM/yyyy")</h4>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead><tr><th>الاسم</th><th>اسم المستخدم</th><th>الفصل</th><th>المرحلة</th><th>وقت الحضور</th></tr></thead>
                    <tbody>
                    @if (Model.StudentAttendance.Any())
                    {
                        @foreach (var record in Model.StudentAttendance)
                        {
                            <tr>
                                <td>@record.User.FullName</td>
                                <td>@record.User.UserName</td>
                                <td>@(record.User.SchoolClass?.Name ?? record.User.ClassName ?? "—")</td>
                                <td>@(record.User.SchoolLevel?.Name ?? record.User.Level ?? "—")</td>
                                <td>@Model.LocalAttendanceTimes[record.Id]</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center text-muted">مفيش حضور للمخدومين في اليوم ده.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card p-3">
            <h4>حضور الخدام بتاريخ @Model.SelectedDate.ToString("dd/MM/yyyy")</h4>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead><tr><th>الاسم</th><th>اسم المستخدم</th><th>وقت الحضور</th><th>طريقة التسجيل</th></tr></thead>
                    <tbody>
                    @if (Model.TeacherAttendance.Any())
                    {
                        @foreach (var record in Model.TeacherAttendance)
                        {
                            <tr>
                                <td>@record.User.FullName</td>
                                <td>@record.User.UserName</td>
                                <td>@Model.LocalAttendanceTimes[record.Id]</td>
                                <td>@record.RegistrationMethod</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center text-muted">مفيش حضور للخدام في اليوم ده.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card p-3">
            <h4>الغير موجودين</h4>
            @if (Model.MissingPeople.Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var item in Model.MissingPeople)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@item.FullName</span>
                            <span class="badge bg-light text-dark">@item.ClassName</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted mb-0">كل المخدومين سجلوا الحضور.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script>
    const searchInput = document.getElementById('searchName');
    const resultsEl = document.getElementById('searchResults');
    const dateInput = document.getElementById('attendanceDate');
    const qrDateInput = document.querySelector('#qrRegistrationForm input[name="attendanceDate"]');
    const qrCodeInput = document.getElementById('qrCode');
    const qrReader = document.getElementById('qrReader');
    const scannerStatus = document.getElementById('scannerStatus');
    const startScanner = document.getElementById('startScanner');
    const stopScanner = document.getElementById('stopScanner');
    let scanner = null;
    let timeoutId = null;

    dateInput.addEventListener('change', () => qrDateInput.value = dateInput.value);

    function stopCamera() {
        if (scanner) scanner.stop().catch(() => {});
        scanner = null;
        qrReader.replaceChildren();
        qrReader.hidden = true;
        stopScanner.hidden = true;
        startScanner.hidden = false;
    }

    stopScanner.addEventListener('click', stopCamera);
    startScanner.addEventListener('click', async () => {
        if (typeof Html5Qrcode === 'undefined') {
            scannerStatus.textContent = 'تعذر تحميل قارئ QR؛ استخدم الإدخال اليدوي.';
            return;
        }

        try {
            qrReader.hidden = false;
            startScanner.hidden = true;
            stopScanner.hidden = false;
            scannerStatus.textContent = 'بنفتح الكاميرا...';
            scanner = new Html5Qrcode('qrReader');
            await scanner.start(
                { facingMode: 'environment' },
                { fps: 10, qrbox: { width: 250, height: 250 } },
                decodedText => {
                    qrCodeInput.value = decodedText;
                    scannerStatus.textContent = 'تم قراءة الكود، جاري تسجيل الحضور.';
                    stopCamera();
                    document.getElementById('qrRegistrationForm').requestSubmit();
                },
                () => {}
            );
            scannerStatus.textContent = 'وجّه الكاميرا ناحية كود QR.';
        } catch {
            stopCamera();
            scannerStatus.textContent = 'مش قادرين نفتح الكاميرا. راجع إذن الكاميرا أو استخدم الإدخال اليدوي.';
        }
    });

    searchInput.addEventListener('input', function () {
        const term = this.value.trim();
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => {
            if (!term) {
                resultsEl.innerHTML = '';
                return;
            }

            fetch(`/Attendance/Search?term=${encodeURIComponent(term)}`)
                .then(r => r.json())
                .then(data => {
                    if (!data.length) {
                        resultsEl.innerHTML = '<div class="text-muted mt-2">لا توجد نتائج.</div>';
                        return;
                    }

                    resultsEl.replaceChildren(...data.map(item => {
                        const card = document.createElement('div');
                        card.className = 'border rounded p-2 mt-2';
                        const name = document.createElement('strong');
                        name.textContent = `${item.fullName} (${item.accountType})`;
                        const details = document.createElement('div');
                        details.className = 'text-muted small';
                        details.textContent = `${item.className || '—'} • ${item.level || '—'}`;
                        const form = document.createElement('form');
                        form.method = 'post';
                        form.action = '/Attendance/RegisterByName';
                        for (const [key, value] of Object.entries({ userId: item.userId, attendanceDate: dateInput.value, __RequestVerificationToken: document.querySelector('input[name=__RequestVerificationToken]')?.value || '' })) {
                            const hidden = document.createElement('input');
                            hidden.type = 'hidden';
                            hidden.name = key;
                            hidden.value = value;
                            form.append(hidden);
                        }
                        const button = document.createElement('button');
                        button.className = 'btn btn-sm btn-primary mt-2';
                        button.type = 'submit';
                        button.textContent = 'تسجيل حضور';
                        form.append(button);
                        card.append(name, details, form);
                        return card;
                    }));
                });
        }, 400);
    });

    window.addEventListener('pagehide', stopCamera);
</script>
}
