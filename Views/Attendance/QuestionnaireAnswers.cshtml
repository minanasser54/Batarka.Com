@model MyMvcApp10.Models.QuestionnaireAnswersPageViewModel
@{
    ViewData["Title"] = "إجابات استبيان الحضور";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h2 class="mb-1">📝 إجابات استبيان الحضور</h2>
        <p class="text-muted small mb-0">متابعة إجابات المخدومين على أسئلة الحضور (القداس، الإنجيل، التناول، الصلاة...) والنقاط الممنوحة</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="btn btn-outline-secondary">📋 تسجيل الحضور</a>
        <a asp-action="ExportQuestionnairesCsv" 
           asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))" 
           asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))" 
           asp-route-search="@Model.Search" 
           asp-route-schoolLevelId="@Model.SchoolLevelId" 
           asp-route-schoolClassId="@Model.SchoolClassId" 
           asp-route-questionId="@Model.QuestionId" 
           asp-route-answerFilter="@Model.AnswerFilter" 
           class="btn btn-success">📥 تنزيل الإجابات CSV</a>
    </div>
</div>

<!-- Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-lg-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-primary border-4 p-3 bg-light h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">إجمالي استبيانات الحضور</div>
                    <div class="fs-3 fw-bold text-primary">@Model.TotalSubmissionsCount</div>
                </div>
                <div class="fs-1">📋</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-success border-4 p-3 bg-light h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">إجمالي النقاط المكتسبة</div>
                    <div class="fs-3 fw-bold text-success">+@Model.TotalPointsAwarded</div>
                </div>
                <div class="fs-1">⭐</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-info border-4 p-3 bg-light h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">عدد المخدومين المشاركين</div>
                    <div class="fs-3 fw-bold text-info">@Model.UniqueStudentsCount</div>
                </div>
                <div class="fs-1">👥</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-warning border-4 p-3 bg-light h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">نسبة الإجابة بنعم</div>
                    <div class="fs-3 fw-bold text-warning">@Model.PositiveAnswerPercentage%</div>
                </div>
                <div class="fs-1">📈</div>
            </div>
        </div>
    </div>
</div>

<!-- Question breakdown overview -->
@if (Model.QuestionStats.Any())
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-2">
            <h6 class="mb-0 fw-bold text-secondary">📊 إحصائيات الأسئلة في النتيجة المحددة</h6>
        </div>
        <div class="card-body p-3">
            <div class="row g-2">
                @foreach (var q in Model.QuestionStats)
                {
                    var percent = q.Value.TotalCount > 0 ? (int)Math.Round((double)q.Value.YesCount * 100 / q.Value.TotalCount) : 0;
                    <div class="col-md-4 col-sm-6">
                        <div class="p-2 border rounded bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-semibold small text-truncate" style="max-width: 180px;" title="@q.Value.Name">@q.Value.Name</span>
                                <span class="badge bg-primary">@q.Value.YesCount / @q.Value.TotalCount (@percent%)</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @percent%;" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Filters Card -->
<div class="card p-3 mb-4 shadow-sm">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label fw-semibold">من تاريخ</label>
            <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold">إلى تاريخ</label>
            <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold">البحث</label>
            <input name="search" value="@Model.Search" class="form-control" placeholder="اسم المخدوم، مستخدم، أو موبايل..." />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold">المرحلة</label>
            <select name="schoolLevelId" class="form-select">
                <option value="">كل المراحل</option>
                @foreach (var lvl in Model.Levels)
                {
                    <option value="@lvl.Id" selected="@(Model.SchoolLevelId == lvl.Id)">@lvl.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold">الفصل</label>
            <select name="schoolClassId" class="form-select">
                <option value="">كل الفصول</option>
                @foreach (var cls in Model.Classes)
                {
                    <option value="@cls.Id" selected="@(Model.SchoolClassId == cls.Id)">@cls.SchoolLevel.Name - @cls.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold">تصفية بسؤال محدد</label>
            <select name="questionId" class="form-select">
                <option value="">كل الأسئلة</option>
                @foreach (var q in Model.AllQuestions)
                {
                    <option value="@q.Id" selected="@(Model.QuestionId == q.Id)">@q.DisplayText (+@q.PointsAwarded)</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold">حالة الإجابة</label>
            <select name="answerFilter" class="form-select">
                <option value="" selected="@(!Model.AnswerFilter.HasValue)">الكل</option>
                <option value="true" selected="@(Model.AnswerFilter == true)">نعم (تم الإنجاز)</option>
                <option value="false" selected="@(Model.AnswerFilter == false)">لا (لم يتم)</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">🔍 تطبيق التصفية</button>
            <a asp-action="QuestionnaireAnswers" class="btn btn-outline-secondary">إعادة ضبط</a>
        </div>
    </form>
</div>

<!-- Submissions Table -->
<div class="card shadow-sm p-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="text-muted small">عدد الاستبيانات المسجلة: <strong>@Model.Submissions.Count</strong></span>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>تاريخ الحضور</th>
                    <th>المخدوم</th>
                    <th>الموبايل</th>
                    <th>المرحلة والفصل</th>
                    <th>ملخص الإجابات</th>
                    <th>النقاط المكتسبة</th>
                    <th>الخادم المسجل</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Submissions.Any())
                {
                    @foreach (var item in Model.Submissions)
                    {
                        var cleanPhone = (item.StudentMobile ?? "").Trim().Replace(" ", "").Replace("-", "");
                        if (cleanPhone.StartsWith("0"))
                        {
                            cleanPhone = "2" + cleanPhone;
                        }

                        <tr>
                            <td>
                                <span class="fw-bold">@item.AttendanceDate.ToString("yyyy-MM-dd")</span>
                                <div class="text-muted small">@item.AttendanceDate.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <a asp-controller="Student" asp-action="Profile" asp-route-id="@item.StudentId" class="fw-bold text-decoration-none text-dark">
                                    @item.StudentName
                                </a>
                                @if (!string.IsNullOrWhiteSpace(item.StudentUserName))
                                {
                                    <div class="text-muted small">@item.StudentUserName</div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.StudentMobile))
                                {
                                    <div class="d-flex align-items-center gap-1">
                                        <a href="tel:@item.StudentMobile" class="text-decoration-none small">📞 @item.StudentMobile</a>
                                        <a href="https://wa.me/@cleanPhone" target="_blank" rel="noreferrer" class="btn btn-sm btn-outline-success py-0 px-1" title="واتساب">💬</a>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                <div><span class="badge bg-secondary">@(item.LevelName ?? "—")</span></div>
                                <small class="text-muted">@(item.ClassName ?? "—")</small>
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap" style="max-width: 320px;">
                                    @foreach (var ans in item.Answers)
                                    {
                                        if (ans.AnswerValue)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success" title="@ans.QuestionText: نعم (+@ans.PointsAwarded نقطة)">
                                                ✓ @ans.QuestionText (+@ans.PointsAwarded)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border" title="@ans.QuestionText: لا">
                                                ✗ @ans.QuestionText
                                            </span>
                                        }
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="badge-score positive fs-6">+@item.TotalPointsAwarded</span>
                                <div class="text-muted small">(@item.AnsweredYesCount من @item.TotalQuestionsCount)</div>
                            </td>
                            <td>
                                <span class="small text-secondary">@(item.SubmittedByName ?? "غير محدد")</span>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modal_@item.SubmissionId">
                                    تفاصيل
                                </button>

                                <!-- Details Modal -->
                                <div class="modal fade" id="modal_@item.SubmissionId" tabindex="-1" aria-labelledby="modalLabel_@item.SubmissionId" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header bg-light">
                                                <h5 class="modal-title" id="modalLabel_@item.SubmissionId">
                                                    تفاصيل إجابات استبيان الحضور
                                                </h5>
                                                <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3 p-2 bg-light rounded">
                                                    <div class="row g-2">
                                                        <div class="col-6"><strong>المخدوم:</strong> @item.StudentName</div>
                                                        <div class="col-6"><strong>الفصل:</strong> @(item.ClassName ?? "—")</div>
                                                        <div class="col-6"><strong>تاريخ الحضور:</strong> @item.AttendanceDate.ToString("dd/MM/yyyy HH:mm")</div>
                                                        <div class="col-6"><strong>الخادم المسجل:</strong> @(item.SubmittedByName ?? "—")</div>
                                                    </div>
                                                </div>

                                                <h6 class="fw-bold mb-2">الأسئلة والإجابات:</h6>
                                                <ul class="list-group mb-3">
                                                    @foreach (var ans in item.Answers)
                                                    {
                                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                                            <span>@ans.QuestionText</span>
                                                            @if (ans.AnswerValue)
                                                            {
                                                                <span class="badge bg-success">نعم (+@ans.PointsAwarded نقطة)</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary">لا (0)</span>
                                                            }
                                                        </li>
                                                    }
                                                </ul>

                                                <div class="alert alert-info py-2 d-flex justify-content-between align-items-center mb-0">
                                                    <span>إجمالي نقاط الاستبيان الممنوحة:</span>
                                                    <span class="fw-bold fs-5 text-primary">+@item.TotalPointsAwarded نقطة</span>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <a asp-controller="Student" asp-action="Profile" asp-route-id="@item.StudentId" class="btn btn-outline-info btn-sm">عرض ملف المخدوم</a>
                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إغلاق</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5">
                            لا توجد أي إجابات استبيان مطابقة للشروط المحددة.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
