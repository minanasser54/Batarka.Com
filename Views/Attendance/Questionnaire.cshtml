@model List<MyMvcApp10.Models.AttendanceQuestionDefinition>
@{
    ViewData["Title"] = "نموذج أسئلة الحضور";
    var student = ViewBag.AttendanceUser as MyMvcApp10.Models.ApplicationUser;
    var attendanceId = (int)ViewBag.AttendanceId;
}

<div class="card p-4">
    <h2>نموذج أسئلة الحضور</h2>
    <p>المخدوم: <strong>@student?.FullName</strong></p>
    <form asp-action="SubmitQuestionnaire" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="attendanceId" value="@attendanceId" />

        @foreach (var question in Model)
        {
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="answeredQuestionIds" value="@question.Id" id="q_@question.Id" />
                <label class="form-check-label" for="q_@question.Id">@question.DisplayText <span class="text-muted small">(+@question.PointsAwarded نقطة)</span></label>
            </div>
        }

        <button class="btn btn-success" type="submit">حفظ الإجابات</button>
    </form>
</div>
