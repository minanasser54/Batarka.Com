@model List<MyMvcApp10.Models.ApplicationUser>
@{
    ViewData["Title"] = "تسجيل الدرجات";
}

<div class="mb-3">
    <h2>تسجيل الدرجات</h2>
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="searchTerm">بحث</label>
            <input id="searchTerm" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="اسم، اسم مستخدم، موبايل أو بريد" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="schoolLevelId">المرحلة</label>
            <select id="schoolLevelId" name="schoolLevelId" class="form-select">
                <option value="">كل المراحل</option>
                @foreach (var level in ViewBag.Levels)
                {
                    <option value="@level.Id" selected="@(ViewBag.SelectedLevelId == level.Id)">@level.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="schoolClassId">الفصل</label>
            <select id="schoolClassId" name="schoolClassId" class="form-select">
                <option value="">كل الفصول</option>
                @foreach (var schoolClass in ViewBag.Classes)
                {
                    <option value="@schoolClass.Id" selected="@(ViewBag.SelectedClassId == schoolClass.Id)">@schoolClass.SchoolLevel.Name - @schoolClass.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">بحث</button></div>
    </form>
    <div class="small text-muted mt-2">المعروض لحد 50 مخدوم. استخدم الاسم أو الموبايل أو البريد أو اختار الفصل.</div>
</div>

<div class="table-responsive card p-3">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>الاسم</th>
                <th>الفصل</th>
                <th>المرحلة</th>
                <th>الرصيد</th>
                <th>إجراء</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.FullName</td>
                        <td>@(student.SchoolClass?.Name ?? student.ClassName ?? "—")</td>
                        <td>@(student.SchoolLevel?.Name ?? student.Level ?? "—")</td>
                        <td><span class="badge-score @(student.GradingBalance >= 0 ? "positive" : "negative")">@student.GradingBalance</span></td>
                        <td>
                            <form asp-action="Apply" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="studentId" value="@student.Id" />
                                <button type="submit" name="action" value="green" class="btn btn-success btn-sm">أخضر +1</button>
                                <button type="submit" name="action" value="red" class="btn btn-danger btn-sm">أحمر -1</button>
                                <button type="submit" name="action" value="black" class="btn btn-dark btn-sm">أسود -5</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5" class="text-center text-muted">لا توجد نتائج.</td></tr>
            }
        </tbody>
    </table>
</div>
