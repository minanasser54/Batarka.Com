@model List<MyMvcApp10.Models.ApplicationUser>
@{
    ViewData["Title"] = "تسجيل الدرجات";
}

<div class="card shadow-sm p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="mb-0">⭐ تسجيل الدرجات</h2>
            <div class="text-muted small">ابحث بالاسم أو الفصل أو امسح كود QR لتسجيل الدرجات بسرعة.</div>
        </div>
        <div id="liveStatus" class="small text-muted align-self-center"></div>
    </div>

    <!-- Search Controls -->
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label fw-bold" for="searchTerm">بحث سريع بالاسم / الموبايل / QR</label>
            <input id="searchTerm" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control form-control-lg" placeholder="اكتب اسم المخدوم، كود QR أو الموبايل..." autocomplete="off" />
        </div>

        <div class="col-md-3">
            <label class="form-label" for="schoolLevelId">المرحلة</label>
            <select id="schoolLevelId" name="schoolLevelId" class="form-select">
                <option value="">كل المراحل</option>
                @foreach (var level in ViewBag.Levels)
                {
                    <option value="@level.Id" selected="@(ViewBag.SelectedLevelId == level.Id)">@level.Name</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label" for="schoolClassId">الفصل</label>
            <select id="schoolClassId" name="schoolClassId" class="form-select">
                <option value="">كل الفصول</option>
                @foreach (var schoolClass in ViewBag.Classes)
                {
                    <option value="@schoolClass.Id" selected="@(ViewBag.SelectedClassId == schoolClass.Id)">@schoolClass.SchoolLevel.Name - @schoolClass.Name</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <button id="resetSearchBtn" type="button" class="btn btn-outline-secondary w-100">مسح البحث</button>
        </div>
    </div>

    <!-- QR Scanner Section -->
    <div class="mt-3 pt-3 border-top">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button id="startQrBtn" type="button" class="btn btn-outline-primary btn-sm">📷 فتح كاميرا الـ QR</button>
            <button id="stopQrBtn" type="button" class="btn btn-outline-secondary btn-sm" hidden>إيقاف الكاميرا</button>
            <span id="qrStatus" class="small text-muted"></span>
        </div>
        <div id="qrReader" class="mt-2" style="max-width: 320px;" hidden></div>
    </div>
</div>

<!-- Results Alert Container -->
<div id="gradingAlert" class="alert d-none py-2" role="alert"></div>

<!-- Students Table -->
<div class="card shadow-sm p-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">قائمة المخدومين (<span id="resultCount">@(Model?.Count ?? 0)</span>)</h5>
        <div class="spinner-border spinner-border-sm text-primary d-none" id="searchSpinner" role="status">
            <span class="visually-hidden">جار التحميل...</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0" id="studentsTable">
            <thead class="table-light">
                <tr>
                    <th>الاسم</th>
                    <th>الفصل</th>
                    <th>المرحلة</th>
                    <th>الرصيد الحالي</th>
                    <th>إجراء رصد الدرجات</th>
                    <th>الملف الشخصي</th>
                </tr>
            </thead>
            <tbody id="studentsBody">
                @if (Model != null && Model.Any())
                {
                    @foreach (var student in Model)
                    {
                        <tr id="row-@student.Id">
                            <td>
                                <a asp-controller="Student" asp-action="Profile" asp-route-id="@student.Id" class="text-decoration-none fw-bold">
                                    @student.FullName
                                </a>
                                <div class="text-muted small">@student.UserName</div>
                            </td>
                            <td>@(student.SchoolClass?.Name ?? student.ClassName ?? "—")</td>
                            <td>@(student.SchoolLevel?.Name ?? student.Level ?? "—")</td>
                            <td>
                                <span class="badge-score balance-badge @(student.GradingBalance >= 0 ? "positive" : "negative")" id="balance-@student.Id">
                                    @student.GradingBalance
                                </span>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-success btn-sm btn-grade" data-id="@student.Id" data-action="green" title="+1 أخضر">أخضر +1</button>
                                    <button type="button" class="btn btn-danger btn-sm btn-grade" data-id="@student.Id" data-action="red" title="-1 أحمر">أحمر -1</button>
                                    <button type="button" class="btn btn-dark btn-sm btn-grade" data-id="@student.Id" data-action="black" title="-5 أسود">أسود -5</button>
                                </div>
                            </td>
                            <td>
                                <a asp-controller="Student" asp-action="Profile" asp-route-id="@student.Id" class="btn btn-outline-info btn-sm">الملف</a>
                                <a asp-controller="QrCode" asp-action="ByUser" asp-route-id="@student.Id" target="_blank" class="btn btn-outline-secondary btn-sm">QR</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="noResultsRow">
                        <td colspan="6" class="text-center text-muted py-4">لا توجد نتائج مطابقة للبحث.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<form id="antiForgeryForm" method="post" hidden>
    @Html.AntiForgeryToken()
</form>

@section Scripts {
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script>
    const searchInput = document.getElementById('searchTerm');
    const levelSelect = document.getElementById('schoolLevelId');
    const classSelect = document.getElementById('schoolClassId');
    const resetBtn = document.getElementById('resetSearchBtn');
    const studentsBody = document.getElementById('studentsBody');
    const resultCount = document.getElementById('resultCount');
    const searchSpinner = document.getElementById('searchSpinner');
    const liveStatus = document.getElementById('liveStatus');
    const alertBox = document.getElementById('gradingAlert');
    const startQrBtn = document.getElementById('startQrBtn');
    const stopQrBtn = document.getElementById('stopQrBtn');
    const qrReader = document.getElementById('qrReader');
    const qrStatus = document.getElementById('qrStatus');

    let qrScanner = null;
    let searchDebounceTimer = null;
    const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value || '';

    function showAlert(message, isSuccess = true) {
        alertBox.className = `alert alert-${isSuccess ? 'success' : 'danger'} py-2 mb-3`;
        alertBox.textContent = message;
        alertBox.classList.remove('d-none');
        setTimeout(() => alertBox.classList.add('d-none'), 3500);
    }

    async function performSearch(qrCodeValue = '') {
        const term = qrCodeValue || searchInput.value.trim();
        const levelId = levelSelect.value;
        const classId = classSelect.value;

        searchSpinner.classList.remove('d-none');
        liveStatus.textContent = 'جاري البحث...';

        try {
            const params = new URLSearchParams();
            if (term) params.append(qrCodeValue ? 'qrCode' : 'searchTerm', term);
            if (levelId) params.append('schoolLevelId', levelId);
            if (classId) params.append('schoolClassId', classId);

            const res = await fetch(`/Grading/LiveSearch?${params.toString()}`, {
                headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!res.ok) throw new Error('فشل البحث');
            const students = await res.json();
            renderStudents(students);
            resultCount.textContent = students.length;
            liveStatus.textContent = `تم العثور على ${students.length} مخدوم`;
        } catch (err) {
            liveStatus.textContent = 'حدث خطأ في البحث';
        } finally {
            searchSpinner.classList.add('d-none');
        }
    }

    function renderStudents(students) {
        if (!students || students.length === 0) {
            studentsBody.innerHTML = `<tr><td colspan="6" class="text-center text-muted py-4">لا توجد نتائج مطابقة للبحث.</td></tr>`;
            return;
        }

        studentsBody.innerHTML = students.map(s => `
            <tr id="row-${s.id}">
                <td>
                    <a href="/Student/Profile/${s.id}" class="text-decoration-none fw-bold">
                        ${escapeHtml(s.fullName)}
                    </a>
                    <div class="text-muted small">${escapeHtml(s.userName || '')}</div>
                </td>
                <td>${escapeHtml(s.className || '—')}</td>
                <td>${escapeHtml(s.levelName || '—')}</td>
                <td>
                    <span class="badge-score balance-badge ${s.gradingBalance >= 0 ? 'positive' : 'negative'}" id="balance-${s.id}">
                        ${s.gradingBalance}
                    </span>
                </td>
                <td>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-success btn-sm btn-grade" data-id="${s.id}" data-action="green" title="+1 أخضر">أخضر +1</button>
                        <button type="button" class="btn btn-danger btn-sm btn-grade" data-id="${s.id}" data-action="red" title="-1 أحمر">أحمر -1</button>
                        <button type="button" class="btn btn-dark btn-sm btn-grade" data-id="${s.id}" data-action="black" title="-5 أسود">أسود -5</button>
                    </div>
                </td>
                <td>
                    <a href="/Student/Profile/${s.id}" class="btn btn-outline-info btn-sm">الملف</a>
                    <a href="/QrCode/ByUser/${s.id}" target="_blank" class="btn btn-outline-secondary btn-sm">QR</a>
                </td>
            </tr>
        `).join('');
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Debounced search on input
    searchInput.addEventListener('input', () => {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => performSearch(), 250);
    });

    levelSelect.addEventListener('change', () => performSearch());
    classSelect.addEventListener('change', () => performSearch());

    resetBtn.addEventListener('click', () => {
        searchInput.value = '';
        levelSelect.value = '';
        classSelect.value = '';
        performSearch();
    });

    // Delegated click event for grading buttons
    studentsBody.addEventListener('click', async (e) => {
        const btn = e.target.closest('.btn-grade');
        if (!btn) return;

        const studentId = btn.getAttribute('data-id');
        const action = btn.getAttribute('data-action');
        if (!studentId || !action) return;

        // Visual feedback
        btn.disabled = true;
        const originalText = btn.textContent;
        btn.textContent = '...';

        try {
            const formData = new FormData();
            formData.append('studentId', studentId);
            formData.append('action', action);
            formData.append('__RequestVerificationToken', token);

            const res = await fetch('/Grading/Apply', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },
                body: formData
            });

            const data = await res.json();
            if (data.success) {
                const badge = document.getElementById(`balance-${studentId}`);
                if (badge) {
                    badge.textContent = data.newBalance;
                    badge.className = `badge-score balance-badge ${data.newBalance >= 0 ? 'positive' : 'negative'}`;
                    // Pulse animation
                    badge.style.transform = 'scale(1.25)';
                    badge.style.transition = 'transform 0.2s ease-in-out';
                    setTimeout(() => badge.style.transform = 'scale(1)', 200);
                }
                showAlert(data.message || 'تم الرصد بنجاح!', true);
            } else {
                showAlert(data.message || 'فشل رصد الدرجة.', false);
            }
        } catch (err) {
            showAlert('حدث خطأ أثناء الاتصال بالخادم.', false);
        } finally {
            btn.disabled = false;
            btn.textContent = originalText;
        }
    });

    // QR Scanner logic
    function stopQr() {
        if (qrScanner) {
            qrScanner.stop().catch(() => {});
            qrScanner = null;
        }
        qrReader.replaceChildren();
        qrReader.hidden = true;
        stopQrBtn.hidden = true;
        startQrBtn.hidden = false;
        qrStatus.textContent = '';
    }

    startQrBtn.addEventListener('click', async () => {
        if (typeof Html5Qrcode === 'undefined') {
            qrStatus.textContent = 'تعذر تحميل مكتبة قراءة الـ QR.';
            return;
        }

        try {
            qrReader.hidden = false;
            startQrBtn.hidden = true;
            stopQrBtn.hidden = false;
            qrStatus.textContent = 'جاري تشغيل الكاميرا...';

            qrScanner = new Html5Qrcode('qrReader');
            await qrScanner.start(
                { facingMode: 'environment' },
                { fps: 10, qrbox: { width: 220, height: 220 } },
                decodedText => {
                    qrStatus.textContent = `تم قراءة الكود بنجاح: ${decodedText.substring(0, 10)}...`;
                    searchInput.value = decodedText;
                    performSearch(decodedText);
                    stopQr();
                },
                () => {}
            );
            qrStatus.textContent = 'وجّه الكاميرا إلى كود QR للمخدوم.';
        } catch (err) {
            stopQr();
            qrStatus.textContent = 'تعذر فتح الكاميرا، يرجى مراجعة الصلاحيات أو استخدام خانة البحث.';
        }
    });

    stopQrBtn.addEventListener('click', stopQr);
    window.addEventListener('pagehide', stopQr);
</script>
}
