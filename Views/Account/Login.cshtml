@model MyMvcApp10.Models.LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="login-box">
    <h2 class="mb-4 text-center">تسجيل الدخول</h2>
    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="UserName" class="form-label"></label>
            <input asp-for="UserName" class="form-control" placeholder="اسم المستخدم" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control" placeholder="كلمة المرور" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">تذكرني</label>
        </div>

        <button type="submit" class="btn btn-primary w-100">دخول</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
