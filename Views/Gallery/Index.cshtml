@model List<MyMvcApp10.Models.GalleryEventViewModel>
@{
    ViewData["Title"] = "معرض الصور";
    var isAdmin = User.IsInRole("Admin");
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">معرض الصور</h1>
        <p class="text-muted mb-0">صور المناسبات والأنشطة</p>
    </div>
    @if (isAdmin)
    {
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="DownloadAll" class="btn btn-outline-success">تنزيل كل الصور ZIP</a>
            <form asp-action="DeleteAll" method="post" onsubmit="return confirm('سيتم حذف كل المناسبات والصور نهائيًا. هل تريد المتابعة؟')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">حذف الكل</button>
            </form>
        </div>
    }
</div>

@if (isAdmin)
{
    <form asp-action="CreateEvent" method="post" class="row g-2 align-items-end border-bottom pb-4 mb-4">
        @Html.AntiForgeryToken()
        <div class="col-md-6">
            <label for="galleryEventName" class="form-label">مجموعة / مناسبة جديدة</label>
            <input id="galleryEventName" name="name" class="form-control" maxlength="150" required placeholder="مثال: رحلة الصيف 2026" />
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-primary">إنشاء مجموعة</button></div>
    </form>
}

@if (Model.Count == 0)
{
    <div class="text-center py-5 border rounded bg-light">
        <h2 class="h5">لا توجد صور في المعرض حتى الآن</h2>
        @if (isAdmin)
        {
            <p class="text-muted mb-0">أنشئ مجموعة مناسبة ثم أضف الصور إليها.</p>
        }
    </div>
}
else
{
    @foreach (var galleryEvent in Model)
    {
        <section class="gallery-event mb-5" aria-labelledby="event-@galleryEvent.Id">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 border-bottom pb-2 mb-3">
                <div>
                    <h2 class="h4 mb-1" id="event-@galleryEvent.Id">@galleryEvent.Name</h2>
                    <span class="text-muted small">@galleryEvent.Images.Count صورة</span>
                </div>
                @if (isAdmin)
                {
                    <div class="d-flex flex-wrap gap-2">
                        @if (galleryEvent.Images.Count > 0)
                        {
                            <a asp-action="DownloadEvent" asp-route-id="@galleryEvent.Id" class="btn btn-sm btn-outline-success">تنزيل المجموعة ZIP</a>
                        }
                        <form asp-action="DeleteEvent" asp-route-id="@galleryEvent.Id" method="post" onsubmit="return confirm('سيتم حذف هذه المناسبة وكل صورها. هل تريد المتابعة؟')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">حذف المجموعة</button>
                        </form>
                    </div>
                }
            </div>

            @if (isAdmin)
            {
                <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2 align-items-end mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="eventId" value="@galleryEvent.Id" />
                    <div class="col-md-8">
                        <label for="images-@galleryEvent.Id" class="form-label">إضافة صور</label>
                        <input id="images-@galleryEvent.Id" type="file" name="images" accept="image/jpeg,image/png,image/gif,image/webp" class="form-control" multiple />
                    </div>
                    <div class="col-auto"><button type="submit" class="btn btn-outline-primary">رفع الصور</button></div>
                </form>
            }

            @if (galleryEvent.Images.Count > 0)
            {
                <div class="gallery-grid">
                    @foreach (var image in galleryEvent.Images)
                    {
                        <figure class="gallery-image">
                            <a asp-action="Image" asp-route-id="@image.Id" target="_blank" rel="noreferrer" aria-label="فتح الصورة بالحجم الكامل: @image.OriginalFileName">
                                <img src="@Url.Action("Image", "Gallery", new { id = image.Id })" alt="@image.OriginalFileName" loading="lazy" />
                            </a>
                            @if (isAdmin)
                            {
                                <figcaption class="d-flex justify-content-between align-items-center gap-2 p-2">
                                    <span class="small text-truncate" title="@image.OriginalFileName">@image.OriginalFileName</span>
                                    <form asp-action="DeleteImage" asp-route-id="@image.Id" method="post" onsubmit="return confirm('حذف الصورة؟')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="حذف الصورة">حذف</button>
                                    </form>
                                </figcaption>
                            }
                        </figure>
                    }
                </div>
            }
        </section>
    }
}

<style>
    .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px; }
    .gallery-image { min-width: 0; margin: 0; overflow: hidden; border: 1px solid #dee2e6; border-radius: 6px; background: #fff; }
    .gallery-image img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: #f1f3f5; }
    .gallery-image figcaption { min-height: 48px; }
</style>