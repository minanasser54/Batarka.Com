@model MyMvcApp10.Models.BulkEditUsersViewModel
@{
    var title = Model.IsTeacher ? "تعديل جماعي للخدام" : "تعديل جماعي للمخدومين";
    var action = Model.IsTeacher ? "BulkEditTeachers" : "BulkEditStudents";
    var updateAction = Model.IsTeacher ? "UpdateBulkEditTeacher" : "UpdateBulkEditStudent";
    ViewData["Title"] = title;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-1">@title</h2>
        <p class="text-muted mb-0">عدل البيانات داخل الصف، ثم اضغط تحديث في نفس الصف لحفظ هذا الحساب فقط.</p>
    </div>
    <a asp-action="@(Model.IsTeacher ? "Teachers" : "Students")" class="btn btn-outline-secondary">رجوع للقائمة</a>
</div>

<form method="get" asp-action="@action" class="row g-2 align-items-end mb-3">
    <div class="col-md-5"><label class="form-label">بحث</label><input name="search" value="@Model.Search" class="form-control" placeholder="الاسم أو اسم المستخدم أو الهاتف" /></div>
    <div class="col-md-3"><label class="form-label">الفصل</label><select name="schoolClassFilterId" class="form-select"><option value="">كل الفصول</option>@foreach (var item in ViewBag.Classes) { <option value="@item.Id" selected="@(Model.SchoolClassFilterId == item.Id)">@item.SchoolLevel.Name - @item.Name</option> }</select></div>
    <div class="col-md-2"><label class="form-label">الحالة</label><select name="activeStatusFilter" class="form-select"><option value="">الكل</option><option value="active" selected="@(Model.ActiveStatusFilter == "active")">نشط</option><option value="inactive" selected="@(Model.ActiveStatusFilter == "inactive")">متوقف</option></select></div>
    <div class="col-md-2 d-flex gap-2"><button class="btn btn-primary flex-grow-1" type="submit">تصفية</button><a asp-action="@action" class="btn btn-outline-secondary">مسح</a></div>
</form>

<div class="table-responsive border rounded">
    <table class="table table-sm table-striped table-hover align-middle mb-0" style="min-width: 3600px">
        <thead class="table-light">
            <tr>
                <th>الاسم</th><th>اسم المستخدم</th><th>الفصل</th><th>الحالة</th>
                <th>رقم الشارع</th><th>العنوان</th><th>رقم الشقة</th><th>العمارة</th><th>علامة مميزة</th><th>ملاحظات العنوان</th>
                <th>التليفون الأرضي</th><th>موبايل 1</th><th>موبايل 2</th>
                <th>يوم الميلاد</th><th>شهر الميلاد</th><th>سنة الميلاد</th><th>أب الاعتراف</th><th>المرحلة الدراسية</th>
                <th>المدرسة / الجامعة</th><th>النوع</th><th>المهنة</th><th>مهنة الأب</th><th>مهنة الأم</th><th>اسم الأم</th>
                <th>خدمات أخرى</th><th>الرقم القومي</th><th>رابط الصورة</th><th>ملاحظات</th><th>كود المنطقة</th><th>حفظ</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var user in Model.Users)
        {
            var formId = "update-row-" + user.Id;
            <tr>
                <td><input form="@formId" name="FullName" value="@user.FullName" class="form-control form-control-sm" style="min-width: 180px" required /></td>
                <td><span class="font-monospace">@user.UserName</span></td>
                <td><select form="@formId" name="SchoolClassId" class="form-select form-select-sm" style="min-width: 170px"><option value="">بدون فصل</option>@foreach (var item in ViewBag.Classes) { <option value="@item.Id" selected="@(user.SchoolClassId == item.Id)">@item.SchoolLevel.Name - @item.Name</option> }</select></td>
                <td><select form="@formId" name="IsActive" class="form-select form-select-sm"><option value="true" selected="@user.IsActive">نشط</option><option value="false" selected="@(!user.IsActive)">متوقف</option></select></td>
                <td><input form="@formId" name="StreetNumber" value="@user.StreetNumber" class="form-control form-control-sm" style="min-width: 100px" /></td>
                <td><input form="@formId" name="Address" value="@user.Address" class="form-control form-control-sm" style="min-width: 180px" /></td>
                <td><input form="@formId" name="ApartmentNumber" value="@user.ApartmentNumber" class="form-control form-control-sm" style="min-width: 90px" /></td>
                <td><input form="@formId" name="Building" value="@user.Building" class="form-control form-control-sm" style="min-width: 100px" /></td>
                <td><input form="@formId" name="Landmark" value="@user.Landmark" class="form-control form-control-sm" style="min-width: 140px" /></td>
                <td><input form="@formId" name="AddressNotes" value="@user.AddressNotes" class="form-control form-control-sm" style="min-width: 160px" /></td>
                <td><input form="@formId" name="Landline" value="@user.Landline" class="form-control form-control-sm" style="min-width: 120px" /></td>
                <td><input form="@formId" name="Mobile" value="@user.Mobile" class="form-control form-control-sm" style="min-width: 120px" /></td>
                <td><input form="@formId" name="Mobile2" value="@user.Mobile2" class="form-control form-control-sm" style="min-width: 120px" /></td>
                <td><input form="@formId" name="BirthDay" type="number" min="1" max="31" value="@user.BirthDay" class="form-control form-control-sm" style="width: 80px" /></td>
                <td><input form="@formId" name="BirthMonth" type="number" min="1" max="12" value="@user.BirthMonth" class="form-control form-control-sm" style="width: 80px" /></td>
                <td><input form="@formId" name="BirthYear" type="number" min="1800" max="2100" value="@user.BirthYear" class="form-control form-control-sm" style="width: 90px" /></td>
                <td><input form="@formId" name="ConfessionFather" value="@user.ConfessionFather" class="form-control form-control-sm" style="min-width: 140px" /></td>
                <td><input form="@formId" name="StudyStage" type="number" min="0" max="9" value="@user.StudyStage" class="form-control form-control-sm" style="width: 90px" /></td>
                <td><input form="@formId" name="SchoolOrUniversity" value="@user.SchoolOrUniversity" class="form-control form-control-sm" style="min-width: 180px" /></td>
                <td><select form="@formId" name="Gender" class="form-select form-select-sm" style="min-width: 100px"><option value="">—</option><option value="ولد" selected="@(user.Gender == "ولد")">ولد</option><option value="بنت" selected="@(user.Gender == "بنت")">بنت</option></select></td>
                <td><input form="@formId" name="Occupation" value="@user.Occupation" class="form-control form-control-sm" style="min-width: 130px" /></td>
                <td><input form="@formId" name="FatherOccupation" value="@user.FatherOccupation" class="form-control form-control-sm" style="min-width: 130px" /></td>
                <td><input form="@formId" name="MotherOccupation" value="@user.MotherOccupation" class="form-control form-control-sm" style="min-width: 130px" /></td>
                <td><input form="@formId" name="MotherName" value="@user.MotherName" class="form-control form-control-sm" style="min-width: 140px" /></td>
                <td><input form="@formId" name="OtherServices" value="@user.OtherServices" class="form-control form-control-sm" style="min-width: 150px" /></td>
                <td><input form="@formId" name="NationalId" value="@user.NationalId" class="form-control form-control-sm" style="min-width: 140px" /></td>
                <td><input form="@formId" name="ImageUrl" value="@user.ImageUrl" class="form-control form-control-sm" style="min-width: 180px" /></td>
                <td><input form="@formId" name="Notes" value="@user.Notes" class="form-control form-control-sm" style="min-width: 180px" /></td>
                <td><input form="@formId" name="AreaCode" value="@user.AreaCode" class="form-control form-control-sm" style="min-width: 100px" /></td>
                <td>
                    <form id="@formId" asp-action="@updateAction" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@user.Id" />
                        <input type="hidden" name="Search" value="@Model.Search" />
                        <input type="hidden" name="SchoolClassFilterId" value="@Model.SchoolClassFilterId" />
                        <input type="hidden" name="ActiveStatusFilter" value="@Model.ActiveStatusFilter" />
                        <button type="submit" class="btn btn-sm btn-primary" title="حفظ صف @user.FullName">تحديث</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Users.Count == 0)
        {
            <tr><td colspan="30" class="text-center text-muted py-4">لا توجد حسابات مطابقة.</td></tr>
        }
        </tbody>
    </table>
</div>