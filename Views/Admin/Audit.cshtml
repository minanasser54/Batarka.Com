@model List<MyMvcApp10.Models.AdminAuditListItemViewModel>
@{
    ViewData["Title"] = "سجل العمليات";
}

<div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>سجل العمليات</h2>
        <span class="text-muted">آخر @Model.Count عملية مطابقة</span>
    </div>
    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-3">
            <label class="form-label" for="search">بحث</label>
            <input id="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="اسم، هدف، تفاصيل أو سبب" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="actionName">نوع العملية</label>
            <select id="actionName" name="actionName" class="form-select">
                <option value="">كل العمليات</option>
                @foreach (var actionName in ViewBag.ActionOptions)
                {
                    <option value="@actionName" selected="@(ViewBag.ActionName == actionName)">@actionName</option>
                }
            </select>
        </div>
        <div class="col-md-2"><label class="form-label" for="from">من تاريخ</label><input id="from" name="from" type="date" value="@ViewBag.From" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label" for="to">لحد تاريخ</label><input id="to" name="to" type="date" value="@ViewBag.To" class="form-control" /></div>
        <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">تصفية</button></div>
        <div class="col-md-1"><a asp-action="Audit" class="btn btn-outline-secondary w-100">مسح</a></div>
    </form>
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>الإجراء</th>
                    <th>بواسطة</th>
                    <th>الهدف</th>
                    <th>التفاصيل</th>
                    <th>السبب</th>
                    <th>التاريخ والوقت</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Action</td>
                            <td>@(item.ActorName ?? "—")<div class="small text-muted">@(item.ActorUserName ?? "")</div></td>
                            <td>@(item.TargetType ?? "—")<div class="small text-muted">@(item.TargetId ?? "")</div></td>
                            <td>@(item.Details ?? "—")</td>
                            <td>@(item.Reason ?? "—")</td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted">لا توجد بيانات مطابقة.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
