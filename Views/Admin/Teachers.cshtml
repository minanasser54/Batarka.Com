@{
    ViewData["Title"] = "إدارة الخدام";
}

<div class="card p-3">
    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
        <h2>إدارة الخدام</h2>
        <a asp-action="BulkEditTeachers" asp-route-search="@ViewBag.Search" asp-route-activeStatusFilter="@ViewBag.ActiveStatus" class="btn btn-outline-primary">تعديل جماعي للخدام</a>
    </div>
    <form method="get" class="row g-2 align-items-end mt-2">
        <div class="col-md-5"><label class="form-label">بحث</label><input name="search" value="@ViewBag.Search" class="form-control" placeholder="الاسم أو اسم المستخدم أو الهاتف" /></div>
        <div class="col-md-3"><label class="form-label">نوع الحساب</label><select name="accountType" class="form-select"><option value="">الكل</option><option value="teacher" selected="@(ViewBag.AccountType == "teacher")">خادم</option><option value="admin" selected="@(ViewBag.AccountType == "admin")">مشرف</option></select></div>
        <div class="col-md-2"><label class="form-label">الحالة</label><select name="activeStatus" class="form-select"><option value="">الكل</option><option value="active" selected="@(ViewBag.ActiveStatus == "active")">نشط</option><option value="inactive" selected="@(ViewBag.ActiveStatus == "inactive")">متوقف</option></select></div>
        <div class="col-md-2 d-flex gap-2"><button class="btn btn-primary flex-grow-1" type="submit">تصفية</button><a asp-action="Teachers" class="btn btn-outline-secondary">مسح</a></div>
    </form>
    <div class="table-responsive mt-3">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>الاسم</th>
                    <th>اسم المستخدم</th>
                    <th>الفصل</th>
                    <th>المرحلة</th>
                    <th>الحالة</th>
                    <th>تاريخ الإنشاء</th>
                    <th>آخر تسجيل دخول</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.UserName</td>
                            <td>@(item.ClassName ?? "—")</td>
                            <td>@(item.Level ?? "—")</td>
                            <td>@(item.IsActive ? "نشط" : "متوقف")</td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>@(item.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            <td class="d-flex gap-1 flex-wrap">
                                <a asp-controller="QrCode" asp-action="ByUser" asp-route-id="@item.Id" target="_blank" rel="noreferrer" class="btn btn-sm btn-outline-secondary">عرض QR</a>
                                <a asp-controller="Student" asp-action="Profile" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">الملف الشخصي</a>
                                <a asp-action="EditUser" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                                <a asp-action="ResetPassword" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">كلمة المرور</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="DeleteUser" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف حساب الخادم [@item.FullName] نهائياً؟');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
