@model MyMvcApp10.Models.BulkStudentImportViewModel
@{
    ViewData["Title"] = "استيراد المستخدمين";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>استيراد المستخدمين</h2>
    <a asp-action="Students" class="btn btn-outline-secondary">إدارة المخدومين</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-6">
        <label class="form-label" for="classFilter">الفصل</label>
        <select id="classFilter" name="schoolClassId" class="form-select">
            <option value="">بدون فصل</option>
            @foreach (var schoolClass in ViewBag.Classes)
            {
                <option value="@schoolClass.Id" selected="@(ViewBag.SelectedClassId == schoolClass.Id)">@schoolClass.SchoolLevel.Name - @schoolClass.Name</option>
            }
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit">عرض الفصل</button></div>
</form>

<section class="border rounded p-3 mb-4">
    <h4>استيراد من CSV</h4>
    <p class="text-muted">الصف الأول للعناوين. الأعمدة الاختيارية تطابق أسماء الحقول العربية أدناه. اسم المستخدم وكلمة المرور اختياريان؛ عند غيابهما ينشأ اسم مستخدم عشوائي وتحتاج الإدارة لتعيين كلمة مرور. الحقول النصية التي تحتوي على فاصلة توضع بين علامتي اقتباس.</p>
    <form asp-action="ImportStudents" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="SchoolClassId" class="form-label">الفصل (اختياري)</label>
                <select asp-for="SchoolClassId" class="form-select">
                    <option value="">بدون فصل</option>
                    @foreach (var schoolClass in ViewBag.Classes)
                    {
                        <option value="@schoolClass.Id">@schoolClass.SchoolLevel.Name - @schoolClass.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="ImportTeachers" class="form-check-input" />
                    <label asp-for="ImportTeachers" class="form-check-label">استيراد قائمة خدام</label>
                </div>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="CsvFile" class="form-label">رفع ملف CSV (اختياري)</label>
            <input asp-for="CsvFile" type="file" accept=".csv,text/csv" class="form-control" />
            <span asp-validation-for="CsvFile" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Rows" class="form-label"></label>
            <textarea asp-for="Rows" class="form-control" rows="8" dir="auto" placeholder="الاسم,رقم الشارع,العنوان,رقم الشقة,العمارة,علامة مميزة,ملاحظات العنوان,التليفون الأرضي,موبايل 1,موبايل 2,يوم الميلاد,شهر الميلاد,سنة الميلاد,أب الاعتراف,المرحلة الدراسية (0-9),المدرسة / الجامعة,النوع (ولد / بنت),المهنة,مهنة الأب,مهنة الأم,اسم الأم,خدمات أخرى,الرقم القومي,رابط الصورة الشخصية,ملاحظات,كود المنطقة"></textarea>
            <span asp-validation-for="Rows" class="text-danger"></span>
        </div>
        <button class="btn btn-success" type="submit">استيراد البيانات</button>
    </form>
    @if (ViewBag.ImportErrors is IEnumerable<string> errors)
    {
        <div class="alert alert-warning mt-3 mb-0">
            @foreach (var error in errors)
            {
                <div>@error</div>
            }
        </div>
    }
</section>

@if (Model.SchoolClassId > 0)
{
    <section class="border rounded p-3">
        <h4>مخدومين الفصل الحالي</h4>
        <p class="text-muted">التعطيل يمنع الدخول ويحافظ على سجل الحضور والدرجات.</p>
        <form asp-action="BulkDeactivateStudents" method="post" onsubmit="return confirm('هيتم تعطيل الحسابات المختارة مع الاحتفاظ بسجلاتها. نكمل؟')">
            <input type="hidden" name="schoolClassId" value="@Model.SchoolClassId" />
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead><tr><th><input type="checkbox" id="selectAllStudents" aria-label="تحديد الكل" /></th><th>الاسم</th><th>اسم المستخدم</th><th>الحالة</th></tr></thead>
                    <tbody>
                    @foreach (var student in ViewBag.ClassStudents)
                    {
                        <tr>
                            <td><input type="checkbox" name="studentIds" value="@student.Id" checked="@student.IsActive" disabled="@(!student.IsActive)" /></td>
                            <td>@student.FullName</td>
                            <td>@student.UserName</td>
                            <td>@(student.IsActive ? "نشط" : "متوقف")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <button class="btn btn-outline-danger" type="submit">تعطيل المحددين</button>
        </form>
    </section>
}

@section Scripts {
<script>
    document.getElementById('selectAllStudents')?.addEventListener('change', event => {
        document.querySelectorAll('input[name="studentIds"]:not(:disabled)').forEach(input => input.checked = event.target.checked);
    });
</script>
}