@model List<MyMvcApp10.Models.AdminStudentListItemViewModel>
@{
    ViewData["Title"] = "إدارة وبيانات المخدومين";
    bool isTeacher = ViewBag.IsTeacher == true;
    bool isAdmin = ViewBag.IsAdmin == true;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h2 class="mb-1">📚 إدارة وبيانات المخدومين</h2>
        <p class="text-muted small mb-0">عرض وتعديل بيانات المخدومين وأرقام الموبايل والعناوين والتواصل</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="StudentInfo" class="btn btn-outline-info">📇 دليل كروت التواصل</a>
        <a asp-action="ExportStudentsCsv" 
           asp-route-search="@Context.Request.Query["search"]" 
           asp-route-schoolClassId="@ViewBag.SelectedClassId" 
           asp-route-schoolLevelId="@ViewBag.SelectedLevelId" 
           asp-route-activeStatus="@Context.Request.Query["activeStatus"]" 
           class="btn btn-outline-success">📥 تنزيل بيانات المخدومين (CSV)</a>
        @if (isAdmin)
        {
            <a asp-action="BulkEditStudents" asp-route-search="@Context.Request.Query["search"]" asp-route-schoolClassFilterId="@ViewBag.SelectedClassId" asp-route-activeStatusFilter="@Context.Request.Query["activeStatus"]" class="btn btn-outline-primary">تعديل جماعي للمخدومين</a>
            <a asp-controller="SchoolStructure" asp-action="Levels" class="btn btn-outline-secondary">المراحل والفصول</a>
            <a asp-action="BulkStudents" class="btn btn-outline-secondary">إدارة جماعية</a>
            <a asp-action="CreateUser" class="btn btn-success">+ إضافة مخدوم أو خادم</a>
        }
    </div>
</div>

<div class="card p-3 mb-3 shadow-sm">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-semibold">البحث</label>
            <input name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="اسم، اسم مستخدم، موبايل، عنوان..." />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold">الفصل</label>
            <select name="schoolClassId" class="form-select">
                <option value="">كل الفصول</option>
                @foreach (var item in ViewBag.Classes)
                {
                    <option value="@item.Id" selected="@(ViewBag.SelectedClassId == item.Id)">@item.SchoolLevel.Name - @item.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold">المرحلة</label>
            <select name="schoolLevelId" class="form-select">
                <option value="">كل المراحل</option>
                @foreach (var item in ViewBag.Levels)
                {
                    <option value="@item.Id" selected="@(ViewBag.SelectedLevelId == item.Id)">@item.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold">الحالة</label>
            <select name="activeStatus" class="form-select">
                <option value="all" selected="@(Context.Request.Query["activeStatus"] == "all")">الكل</option>
                <option value="active" selected="@(Context.Request.Query["activeStatus"] == "active")">نشط</option>
                <option value="inactive" selected="@(Context.Request.Query["activeStatus"] == "inactive")">غير نشط</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">🔍 تصفية وبحث</button>
            <a asp-action="Students" class="btn btn-outline-secondary">إعادة ضبط</a>
        </div>
    </form>
</div>

<div class="card shadow-sm p-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="text-muted small">إجمالي المخدومين في النتيجة: <strong>@(Model?.Count ?? 0)</strong></span>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>الاسم</th>
                    <th>اسم المستخدم</th>
                    <th>الموبايل والتواصل</th>
                    <th>العنوان</th>
                    <th>المرحلة والفصل</th>
                    <th>الفريق</th>
                    <th>الرصيد</th>
                    <th>الحضور</th>
                    <th>ملاحظات</th>
                    <th>البيانات الكاملة</th>
                    <th>الحالة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Student" asp-action="Profile" asp-route-id="@item.UserId" class="fw-bold text-decoration-none text-dark">
                                    @item.FullName
                                </a>
                            </td>
                            <td><span class="badge bg-light text-dark font-monospace">@item.UserName</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Mobile))
                                {
                                    <div class="d-flex align-items-center gap-1">
                                        <a href="tel:@item.Mobile" class="text-decoration-none fw-semibold" title="اتصال هاتفي">
                                            📞 @item.Mobile
                                        </a>
                                        @{
                                            var cleanPhone = item.Mobile.Trim().Replace(" ", "").Replace("-", "");
                                            if (cleanPhone.StartsWith("0"))
                                            {
                                                cleanPhone = "2" + cleanPhone;
                                            }
                                        }
                                        <a href="https://wa.me/@cleanPhone" target="_blank" rel="noreferrer" class="btn btn-sm btn-outline-success py-0 px-1" title="محادثة واتساب">
                                            💬 واتساب
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">غير مسجل</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Address))
                                {
                                    <span title="@item.Address">📍 @item.Address</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                <div><span class="badge bg-secondary">@(item.Level ?? "—")</span></div>
                                <small class="text-muted">@(item.ClassName ?? "—")</small>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.TeamName))
                                {
                                    <span class="badge bg-info text-dark">👥 @item.TeamName</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                <span class="badge-score @(item.GradingBalance >= 0 ? "positive" : "negative")">@item.GradingBalance</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.TotalAttendance مرة</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <span class="d-inline-block text-truncate" style="max-width: 120px;" title="@item.Notes">
                                        📝 @item.Notes
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                <details>
                                    <summary class="text-primary">عرض البيانات</summary>
                                    <dl class="row small mt-2 mb-0" style="min-width: 280px">
                                        <dt class="col-5">رقم الشارع</dt><dd class="col-7">@(item.StreetNumber ?? "—")</dd>
                                        <dt class="col-5">رقم الشقة</dt><dd class="col-7">@(item.ApartmentNumber ?? "—")</dd>
                                        <dt class="col-5">العمارة</dt><dd class="col-7">@(item.Building ?? "—")</dd>
                                        <dt class="col-5">علامة مميزة</dt><dd class="col-7">@(item.Landmark ?? "—")</dd>
                                        <dt class="col-5">ملاحظات العنوان</dt><dd class="col-7">@(item.AddressNotes ?? "—")</dd>
                                        <dt class="col-5">التليفون الأرضي</dt><dd class="col-7">@(item.Landline ?? "—")</dd>
                                        <dt class="col-5">موبايل 2</dt><dd class="col-7">@(item.Mobile2 ?? "—")</dd>
                                        <dt class="col-5">الميلاد</dt><dd class="col-7">@string.Join("/", new[] { item.BirthDay?.ToString(), item.BirthMonth?.ToString(), item.BirthYear?.ToString() }.Where(value => value != null))</dd>
                                        <dt class="col-5">أب الاعتراف</dt><dd class="col-7">@(item.ConfessionFather ?? "—")</dd>
                                        <dt class="col-5">المرحلة الدراسية</dt><dd class="col-7">@(item.StudyStage?.ToString() ?? "—")</dd>
                                        <dt class="col-5">المدرسة / الجامعة</dt><dd class="col-7">@(item.SchoolOrUniversity ?? "—")</dd>
                                        <dt class="col-5">النوع</dt><dd class="col-7">@(item.Gender ?? "—")</dd>
                                        <dt class="col-5">المهنة</dt><dd class="col-7">@(item.Occupation ?? "—")</dd>
                                        <dt class="col-5">مهنة الأب</dt><dd class="col-7">@(item.FatherOccupation ?? "—")</dd>
                                        <dt class="col-5">مهنة الأم</dt><dd class="col-7">@(item.MotherOccupation ?? "—")</dd>
                                        <dt class="col-5">اسم الأم</dt><dd class="col-7">@(item.MotherName ?? "—")</dd>
                                        <dt class="col-5">خدمات أخرى</dt><dd class="col-7">@(item.OtherServices ?? "—")</dd>
                                        <dt class="col-5">الرقم القومي</dt><dd class="col-7">@(item.NationalId ?? "—")</dd>
                                        <dt class="col-5">رابط الصورة</dt><dd class="col-7">@(item.ImageUrl ?? "—")</dd>
                                        <dt class="col-5">رابط GPS</dt><dd class="col-7">@if (!string.IsNullOrWhiteSpace(item.GpsLink)) { <a href="@item.GpsLink" target="_blank" rel="noreferrer">فتح الموقع</a> } else { <text>—</text> }</dd>
                                        <dt class="col-5">كود المنطقة</dt><dd class="col-7">@(item.AreaCode ?? "—")</dd>
                                    </dl>
                                </details>
                            </td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">@(item.IsActive ? "نشط" : "متوقف")</span>
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <a asp-controller="QrCode" asp-action="ByUser" asp-route-id="@item.UserId" target="_blank" rel="noreferrer" class="btn btn-sm btn-outline-secondary" title="كود QR">QR</a>
                                    <a asp-controller="Student" asp-action="Profile" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-info" title="الملف">ملف</a>
                                    <a asp-action="EditUser" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-primary" title="تعديل">تعديل</a>
                                    @if (isAdmin)
                                    {
                                        <a asp-action="ResetPassword" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-warning" title="كلمة المرور">كلمة المرور</a>
                                        <form asp-action="DeleteUser" asp-route-id="@item.UserId" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف حساب [@item.FullName] نهائياً؟');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">حذف</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="12" class="text-center text-muted py-4">
                            لا توجد بيانات مطابقة لخيارات البحث المحددة.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
