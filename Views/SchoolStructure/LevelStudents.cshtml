@model List<MyMvcApp10.Models.AdminStudentListItemViewModel>
@{
    ViewData["Title"] = "مخدومين المرحلة";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>مخدومين @ViewBag.LevelTitle</h2>
    <a asp-action="ExportLevelStudents" asp-route-id="@ViewBag.LevelId" class="btn btn-success">تنزيل CSV</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>الاسم</th><th>اسم المستخدم</th><th>الفصل</th><th>الرصيد</th><th>الحضور</th><th>الحالة</th><th>إجراءات</th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted">مفيش مخدومين مسجلين في المرحلة دي.</td></tr>
        }
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.FullName</td>
                <td>@student.UserName</td>
                <td>@(student.ClassName ?? "—")</td>
                <td>@student.GradingBalance</td>
                <td>@student.TotalAttendance</td>
                <td>@(student.IsActive ? "نشط" : "متوقف")</td>
                <td><a asp-controller="Admin" asp-action="EditUser" asp-route-id="@student.UserId" class="btn btn-sm btn-outline-primary">تعديل</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>