@model List<MyMvcApp10.Models.AdminStudentListItemViewModel>
@{
    ViewData["Title"] = "مخدومين المرحلة";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>مخدومين @ViewBag.LevelTitle</h2>
    <a asp-action="ExportLevelStudents" asp-route-id="@ViewBag.LevelId" asp-route-search="@ViewBag.Search" asp-route-activeStatus="@ViewBag.ActiveStatus" class="btn btn-success">تنزيل CSV</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="id" value="@ViewBag.LevelId" />
    <div class="col-md-6"><label class="form-label">بحث في المخدومين</label><input name="search" value="@ViewBag.Search" class="form-control" placeholder="الاسم أو اسم المستخدم أو الهاتف أو العنوان" /></div>
    <div class="col-md-3"><label class="form-label">الحالة</label><select name="activeStatus" class="form-select"><option value="">الكل</option><option value="active" selected="@(ViewBag.ActiveStatus == "active")">نشط</option><option value="inactive" selected="@(ViewBag.ActiveStatus == "inactive")">متوقف</option></select></div>
    <div class="col-md-3 d-flex gap-2"><button class="btn btn-primary flex-grow-1" type="submit">تصفية</button><a asp-action="LevelStudents" asp-route-id="@ViewBag.LevelId" class="btn btn-outline-secondary">مسح</a></div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>الاسم</th><th>اسم المستخدم</th><th>الموبايل</th><th>العنوان</th><th>الفصل</th><th>الرصيد</th><th>الحضور</th><th>الحالة</th><th>إجراءات</th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="9" class="text-center text-muted">مفيش مخدومين مسجلين في المرحلة دي.</td></tr>
        }
        @foreach (var student in Model)
        {
            <tr>
                <td>
                    <a asp-controller="Student" asp-action="Profile" asp-route-id="@student.UserId" class="fw-bold text-decoration-none text-dark">
                        @student.FullName
                    </a>
                </td>
                <td>@student.UserName</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(student.Mobile))
                    {
                        var cleanPhone = student.Mobile.Trim().Replace(" ", "").Replace("-", "");
                        if (cleanPhone.StartsWith("0")) cleanPhone = "2" + cleanPhone;
                        <div class="d-flex align-items-center gap-1">
                            <a href="tel:@student.Mobile" class="text-decoration-none small">📞 @student.Mobile</a>
                            <a href="https://wa.me/@cleanPhone" target="_blank" rel="noreferrer" class="btn btn-sm btn-outline-success py-0 px-1" title="واتساب">💬</a>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small">—</span>
                    }
                </td>
                <td>@(string.IsNullOrWhiteSpace(student.Address) ? "—" : student.Address)</td>
                <td>@(student.ClassName ?? "—")</td>
                <td>@student.GradingBalance</td>
                <td>@student.TotalAttendance</td>
                <td>@(student.IsActive ? "نشط" : "متوقف")</td>
                <td><a asp-controller="Admin" asp-action="EditUser" asp-route-id="@student.UserId" class="btn btn-sm btn-outline-primary">تعديل</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>