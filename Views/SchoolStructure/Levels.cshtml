@model List<MyMvcApp10.Models.SchoolLevel>
@{
    ViewData["Title"] = "إدارة المراحل";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>المراحل الدراسية</h2>
    <a asp-action="Classes" class="btn btn-outline-primary">إدارة الفصول</a>
</div>

<form asp-action="CreateLevel" method="post" class="row g-2 align-items-end border-bottom pb-3 mb-3">
    <div class="col-md-6">
        <label class="form-label" for="levelName">اسم المرحلة</label>
        <input id="levelName" name="name" class="form-control" maxlength="120" required />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="levelSort">ترتيب الظهور</label>
        <input id="levelSort" name="sortOrder" type="number" class="form-control" value="0" />
    </div>
    <div class="col-md-3"><button class="btn btn-success w-100" type="submit">إضافة مرحلة</button></div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>المرحلة</th><th>عدد الفصول</th><th>إجراءات</th></tr></thead>
        <tbody>
        @foreach (var level in Model)
        {
            <tr>
                <td>@level.Name</td>
                <td>@level.Classes.Count</td>
                <td class="d-flex gap-2">
                    <a asp-action="LevelStudents" asp-route-id="@level.Id" class="btn btn-sm btn-outline-secondary">طلاب المرحلة</a>
                    <a asp-action="Classes" asp-route-levelId="@level.Id" class="btn btn-sm btn-outline-secondary">الفصول</a>
                    <a asp-action="EditLevel" asp-route-id="@level.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                    <form asp-action="DeleteLevel" asp-route-id="@level.Id" method="post" onsubmit="return confirm('متأكد إنك عايز تمسح المرحلة؟')">
                        <button class="btn btn-sm btn-outline-danger" type="submit">حذف</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>