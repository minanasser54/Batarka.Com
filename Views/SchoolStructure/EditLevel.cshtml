@model MyMvcApp10.Models.SchoolLevel
@{
    ViewData["Title"] = "تعديل المرحلة";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h2 class="mb-3">تعديل المرحلة</h2>
        <form asp-action="EditLevel" asp-route-id="@Model.Id" method="post" class="border rounded p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label class="form-label" for="name">اسم المرحلة</label>
                <input id="name" name="name" value="@Model.Name" class="form-control" maxlength="120" required />
                <span class="text-danger" asp-validation-for="Name"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" for="sortOrder">ترتيب الظهور</label>
                <input id="sortOrder" name="sortOrder" value="@Model.SortOrder" type="number" class="form-control" />
            </div>
            <button class="btn btn-primary" type="submit">حفظ التعديلات</button>
            <a asp-action="Levels" class="btn btn-outline-secondary">رجوع</a>
        </form>
    </div>
</div>