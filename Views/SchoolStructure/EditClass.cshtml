@model MyMvcApp10.Models.SchoolClass
@{
    ViewData["Title"] = "تعديل الفصل";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h2 class="mb-3">تعديل الفصل</h2>
        <form asp-action="EditClass" asp-route-id="@Model.Id" method="post" class="border rounded p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label class="form-label" for="name">اسم الفصل</label>
                <input id="name" name="name" value="@Model.Name" class="form-control" maxlength="120" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="schoolLevelId">المرحلة</label>
                <select id="schoolLevelId" name="schoolLevelId" class="form-select" required>
                    @foreach (var level in ViewBag.Levels)
                    {
                        <option value="@level.Id" selected="@(Model.SchoolLevelId == level.Id)">@level.Name</option>
                    }
                </select>
            </div>
            <button class="btn btn-primary" type="submit">حفظ التعديلات</button>
            <a asp-action="Classes" class="btn btn-outline-secondary">رجوع</a>
        </form>
    </div>
</div>